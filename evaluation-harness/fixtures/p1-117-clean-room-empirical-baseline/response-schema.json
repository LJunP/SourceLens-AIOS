{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/schemas/p1-117-provider-selection-v1.json",
  "title": "P1-117 finite provider selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_operation_id"],
  "properties": {
    "schema_version": {"const": "p1-117-provider-selection/v1"},
    "selected_operation_id": {
      "type": "string",
      "pattern": "^REP00[1-6]_[A-Z0-9_]+$",
      "minLength": 8,
      "maxLength": 96
    }
  }
}
