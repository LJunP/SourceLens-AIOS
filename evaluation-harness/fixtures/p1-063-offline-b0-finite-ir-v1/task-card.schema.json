{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/schemas/aios/p1-063-quality-task-card-v1.json",
  "title": "SourceLens AIOS P1-063 Quality Task Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "freeze_effective_only_with_external_quality_receipt",
    "task_id",
    "control_id",
    "quality_owner",
    "worker_may_modify",
    "identity",
    "quality_assets",
    "accepted_inputs",
    "accepted_substrate",
    "closed_ir",
    "worker_import_policy",
    "filesystem_policy",
    "required_actions",
    "runner_interface",
    "candidate_manifest_contract",
    "run_evidence_contract",
    "stable_projection",
    "negative_control_acceptance",
    "run_b_procedure",
    "permissions",
    "compatibility_boundary",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "sourcelens_aios_p1_063_quality_task_card" },
    "status": { "const": "QUALITY_FREEZE_CANDIDATE" },
    "freeze_effective_only_with_external_quality_receipt": { "const": true },
    "task_id": { "const": "AIOS-P1-063_CLEAN_ROOM_OFFLINE_RESULT_ADMISSION_AND_B0_ADAPTER" },
    "control_id": { "const": "SL-P1-REP-001-RANGE-NORMALIZATION" },
    "quality_owner": { "const": "Quality and Evaluation Agent" },
    "worker_may_modify": { "const": false },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_commit", "contract", "authority", "write_allowlist"],
      "properties": {
        "activation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "byte_length", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "byte_length": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "authority": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "write_allowlist": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "byte_length", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "byte_length": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "quality_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "task_card_schema", "offline_submission_schema", "offline_submission", "expected_results", "negative_cases", "golden_stable_projection"],
      "properties": {
        "evaluator": { "type": "string" },
        "task_card_schema": { "type": "string" },
        "offline_submission_schema": { "type": "string" },
        "offline_submission": { "type": "string" },
        "expected_results": { "type": "string" },
        "negative_cases": { "type": "string" },
        "golden_stable_projection": { "type": "string" }
      }
    },
    "accepted_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_spec", "source_preimage", "issue_test", "regression_test", "expected_base_failure", "materialization_recipe"],
      "properties": {
        "task_spec": { "$ref": "#/$defs/fileIdentity" },
        "source_preimage": { "$ref": "#/$defs/modeFileIdentity" },
        "issue_test": { "$ref": "#/$defs/modeFileIdentity" },
        "regression_test": { "$ref": "#/$defs/modeFileIdentity" },
        "expected_base_failure": { "$ref": "#/$defs/fileIdentity" },
        "materialization_recipe": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "accepted_substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "independent_oracle", "success_program"],
      "properties": {
        "compiler": { "$ref": "#/$defs/versionedFileIdentity" },
        "independent_oracle": { "$ref": "#/$defs/versionedFileIdentity" },
        "success_program": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "program_id", "outcome_id", "byte_length", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "program_id": { "const": "IR10" },
            "outcome_id": { "const": "CORRECT_END_START" },
            "byte_length": { "const": 255 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "closed_ir": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "maximum_proposal_bytes", "admission_order", "decode_or_parse", "closed_program_ids", "only_success_program_id"],
      "properties": {
        "schema": { "const": "SL-PATCH-IR/1" },
        "maximum_proposal_bytes": { "const": 255 },
        "admission_order": { "type": "array", "items": { "type": "string" }, "minItems": 5, "maxItems": 5 },
        "decode_or_parse": { "const": false },
        "closed_program_ids": { "type": "array", "items": { "enum": ["IR00", "IR01", "IR10", "IR11"] }, "minItems": 4, "maxItems": 4, "uniqueItems": true },
        "only_success_program_id": { "const": "IR10" }
      }
    },
    "worker_import_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_before_candidate_import_or_execution", "worker_files", "static_import_allowlist", "dynamic_import_allowed", "require_allowed", "network_capable_import_or_api_allowed"],
      "properties": {
        "scan_before_candidate_import_or_execution": { "const": true },
        "worker_files": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3, "uniqueItems": true },
        "static_import_allowlist": {
          "type": "object", "additionalProperties": false,
          "required": [
            "evaluation-harness/adapters/p1-063-offline-b0-finite-ir-v1/offline-adapter.mjs",
            "evaluation-harness/harness/p1-063-offline-b0-finite-ir-v1/runner.mjs",
            "scripts/verify-p1-063-offline-b0-finite-ir-v1.sh"
          ],
          "properties": {
            "evaluation-harness/adapters/p1-063-offline-b0-finite-ir-v1/offline-adapter.mjs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "evaluation-harness/harness/p1-063-offline-b0-finite-ir-v1/runner.mjs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "scripts/verify-p1-063-offline-b0-finite-ir-v1.sh": { "type": "array", "maxItems": 0 }
          }
        },
        "dynamic_import_allowed": { "const": false },
        "require_allowed": { "const": false },
        "network_capable_import_or_api_allowed": { "const": false }
      }
    },
    "filesystem_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["file_leaf", "directory"],
      "properties": {
        "file_leaf": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "symlink_allowed", "nlink_required", "open_no_follow", "descriptor_and_path_dev_ino_must_match", "create_once"],
          "properties": {
            "type": { "const": "regular" }, "symlink_allowed": { "const": false }, "nlink_required": { "const": 1 },
            "open_no_follow": { "const": true }, "descriptor_and_path_dev_ino_must_match": { "const": true }, "create_once": { "const": true }
          }
        },
        "directory": {
          "type": "object", "additionalProperties": false,
          "required": ["atomic_exclusive_mkdir", "recursive_mkdir", "type", "symlink_allowed", "realpath_must_equal_absolute_path", "dev_ino_identity_must_remain_stable", "nlink_gate"],
          "properties": {
            "atomic_exclusive_mkdir": { "const": true }, "recursive_mkdir": { "const": false }, "type": { "const": "directory" },
            "symlink_allowed": { "const": false }, "realpath_must_equal_absolute_path": { "const": true },
            "dev_ino_identity_must_remain_stable": { "const": true }, "nlink_gate": { "const": false }
          }
        }
      }
    },
    "required_actions": { "type": "array", "items": { "type": "string" }, "minItems": 18, "maxItems": 18, "uniqueItems": true },
    "runner_interface": {
      "type": "object", "additionalProperties": false,
      "required": ["positive_submission_path_is_fixed", "open_submission_path_cli_allowed", "run_id_pattern", "quality_cli"],
      "properties": {
        "positive_submission_path_is_fixed": { "const": true },
        "open_submission_path_cli_allowed": { "const": false },
        "run_id_pattern": { "type": "string" },
        "quality_cli": {
          "type": "object", "additionalProperties": false,
          "required": ["preflight_candidate", "evaluate_run", "compare_runs", "self_test"],
          "properties": {
            "preflight_candidate": { "type": "string" }, "evaluate_run": { "type": "string" },
            "compare_runs": { "type": "string" }, "self_test": { "type": "string" }
          }
        }
      }
    },
    "candidate_manifest_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "required_keys", "worker_file_required_keys"],
      "properties": {
        "record_type": { "type": "string" },
        "required_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "worker_file_required_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "run_evidence_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["run_manifest_record_type", "run_manifest_required_keys", "required_artifacts", "artifact_required_keys", "raw_streams_retained_and_hash_bound", "manifest_is_not_a_success_oracle"],
      "properties": {
        "run_manifest_record_type": { "type": "string" },
        "run_manifest_required_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_artifacts": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "path"],
            "properties": { "id": { "type": "string" }, "path": { "type": "string" } }
          }
        },
        "artifact_required_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "raw_streams_retained_and_hash_bound": { "const": true },
        "manifest_is_not_a_success_oracle": { "const": true }
      }
    },
    "stable_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["golden_path", "candidate_placeholders", "canonical_json_required", "run_a_run_b_requirement", "excluded_physical_fields"],
      "properties": {
        "golden_path": { "type": "string" },
        "candidate_placeholders": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4, "uniqueItems": true },
        "canonical_json_required": { "const": true },
        "run_a_run_b_requirement": { "const": "EXACT_CANONICAL_JSON_BYTE_EQUALITY" },
        "excluded_physical_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "negative_control_acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "scheduled", "required_rejections", "maximum_false_accepts", "network_fixture_generation"],
      "properties": {
        "path": { "type": "string" }, "scheduled": { "const": 28 }, "required_rejections": { "const": 28 },
        "maximum_false_accepts": { "const": 0 }, "network_fixture_generation": { "type": "string" }
      }
    },
    "run_b_procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "must_not_read_run_a_before_run_b_evaluation", "must_use_distinct_fresh_run_id_and_directory", "must_not_accept_run_a_path_result_or_verdict_as_input", "steps"],
      "properties": {
        "actor": { "type": "string" },
        "must_not_read_run_a_before_run_b_evaluation": { "const": true },
        "must_use_distinct_fresh_run_id_and_directory": { "const": true },
        "must_not_accept_run_a_path_result_or_verdict_as_input": { "const": true },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 9, "maxItems": 9, "uniqueItems": true }
      }
    },
    "permissions": { "$ref": "#/$defs/falseEffects" },
    "compatibility_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["harness_compatible_run_record_required", "accepted_task_spec_response_format_is_summary_changed_paths_tests_json", "finite_ir_is_not_the_accepted_task_spec_response_format", "full_baseline_adapter_contract_acceptance_claimed", "vtsr_inclusion"],
      "properties": {
        "harness_compatible_run_record_required": { "const": true },
        "accepted_task_spec_response_format_is_summary_changed_paths_tests_json": { "const": true },
        "finite_ir_is_not_the_accepted_task_spec_response_format": { "const": true },
        "full_baseline_adapter_contract_acceptance_claimed": { "const": false },
        "vtsr_inclusion": { "const": false }
      }
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": { "type": "string" }, "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "modeFileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byte_length", "sha256", "mode"],
      "properties": {
        "path": { "type": "string" }, "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "mode": { "const": "100644" }
      }
    },
    "versionedFileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "byte_length", "sha256"],
      "properties": {
        "path": { "type": "string" }, "version": { "type": "string" }, "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "falseEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "provider", "secret", "remote", "production", "public", "canonical_source_as_materialization_or_patch_target"],
      "properties": {
        "network": { "const": false }, "provider": { "const": false }, "secret": { "const": false },
        "remote": { "const": false }, "production": { "const": false }, "public": { "const": false },
        "canonical_source_as_materialization_or_patch_target": { "const": false }
      }
    }
  }
}
