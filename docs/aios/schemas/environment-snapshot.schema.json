{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/schemas/aios/environment-snapshot-v1.json",
  "title": "SourceLens AIOS EnvironmentSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "created_at", "source", "runtime", "dependencies", "model",
    "prompt_version", "policy_version", "tools", "network", "environment_variables", "secret_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_identity", "base_commit", "tree_hash", "worktree_clean"],
      "properties": {
        "repository_identity": { "type": "string", "minLength": 1 },
        "base_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "tree_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "worktree_clean": { "const": true }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture", "container_image_digest", "locale", "timezone"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "container_image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["lockfiles", "toolchains", "caches"],
      "properties": {
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "toolchains": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "caches": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "policy", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "policy": { "enum": ["disabled", "read_only", "frozen"] },
              "digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            },
            "allOf": [
              {
                "if": { "properties": { "policy": { "const": "disabled" } } },
                "then": { "properties": { "digest": { "type": "null" } } },
                "else": { "properties": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
              }
            ]
          }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_ref", "provider", "model_id", "model_version", "parameters"],
      "properties": {
        "model_ref": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true }
      }
    },
    "prompt_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tool_id", "version", "permission"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "permission": { "enum": ["observe", "suggest", "modify_isolated", "execute_isolated"] }
        }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "allowed_hosts"],
      "properties": {
        "policy": { "enum": ["none", "fixture_only", "declared_allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "environment_variables": {
      "type": "object", "additionalProperties": false,
      "required": ["non_secret_values", "secret_names_present"],
      "properties": {
        "non_secret_values": { "type": "object", "additionalProperties": { "type": "string" } },
        "secret_names_present": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "secret_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["values_retained", "redaction_policy_version"],
      "properties": {
        "values_retained": { "const": false },
        "redaction_policy_version": { "type": "string", "minLength": 1 }
      }
    },
    "random_seed": { "type": ["integer", "null"] }
  }
}
