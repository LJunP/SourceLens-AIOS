diff --git a/src/unique.mjs b/src/unique.mjs
new file mode 100644
--- /dev/null
+++ b/src/unique.mjs
@@ -0,0 +1,8 @@
+export function uniqueStable(values) {
+  const seen = new Set();
+  return values.filter((value) => {
+    if (seen.has(value)) return false;
+    seen.add(value);
+    return true;
+  });
+}
