# SourceLens - 环境变量模板
# 复制此文件为 .env 并填入实际值
# 仅用于 Docker Compose / 部署场景

# === 数据库 ===
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=sourcelens
MYSQL_USER=sourcelens
MYSQL_PASSWORD=your_app_password
DB_URL=jdbc:mysql://sourcelens-mysql:3306/sourcelens?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=sourcelens
DB_PASSWORD=your_app_password

# === Redis ===
REDIS_HOST=sourcelens-redis
REDIS_PORT=6379

# === JWT ===
JWT_SECRET=change-this-to-a-random-64-char-string

# === 加密 ===
ENCRYPT_PASSWORD=change-this-password
ENCRYPT_SALT=change-this-salt

# === 工作空间 ===
SOURCELENS_WORKSPACE=/var/lib/sourcelens/repos
SOURCELENS_SANDBOX_EXECUTOR=docker
SOURCELENS_SANDBOX_DOCKER_IMAGE=alpine/git:latest@sha256:8d6ede0b29c666ac111c732468c4d758c1c08f054f211dd98f15d421a6ffab40
SOURCELENS_SANDBOX_DOCKER_MEMORY=512m
SOURCELENS_SANDBOX_DOCKER_CPUS=1.0
SOURCELENS_SANDBOX_DOCKER_NETWORK=none
SOURCELENS_SANDBOX_DOCKER_USER=1000:1000
SOURCELENS_SANDBOX_DOCKER_PIDS_LIMIT=256
SOURCELENS_SANDBOX_DOCKER_READ_ONLY_ROOT=true
SOURCELENS_SANDBOX_DOCKER_TMPFS=/tmp:rw,noexec,nosuid,size=64m
SOURCELENS_ALLOW_PAT_CREDENTIALS=false
SOURCELENS_ALLOW_LOCAL_FILE_REPOS=false
SOURCELENS_AGENT_WRITE_PATCH_ENABLED=false
SOURCELENS_AGENT_EXEC_TEST_ENABLED=false
SOURCELENS_AGENT_CREATE_PR_ENABLED=false
SOURCELENS_AUTOREPAIR_SUBMIT_PR_ENABLED=false

# === 保留期清理；生产环境应按容量、审计和排障窗口显式配置 ===
SOURCELENS_WORKSPACE_SANDBOX_CLEANUP_ENABLED=false
SOURCELENS_WORKSPACE_SANDBOX_RETENTION_HOURS=24
SOURCELENS_WORKSPACE_SANDBOX_CLEANUP_BATCH_SIZE=100
SOURCELENS_ARTIFACT_CLEANUP_ENABLED=false
SOURCELENS_ARTIFACT_RETENTION_DAYS=30
SOURCELENS_ARTIFACT_CLEANUP_BATCH_SIZE=200
SOURCELENS_AUDIT_CLEANUP_ENABLED=false
SOURCELENS_AUDIT_RETENTION_DAYS=90
SOURCELENS_AUDIT_CLEANUP_BATCH_SIZE=500
SOURCELENS_EXECUTION_LOG_CLEANUP_ENABLED=false
SOURCELENS_EXECUTION_LOG_RETENTION_DAYS=30
SOURCELENS_EXECUTION_LOG_CLEANUP_BATCH_SIZE=1000

# === GitHub App，可选；启用受控 PR 或 webhook E2E 时必须填写 ===
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_ALLOWED_API_HOSTS=api.github.com
GITHUB_WEBHOOK_DELIVERY_CLEANUP_ENABLED=false
GITHUB_WEBHOOK_DELIVERY_RETENTION_DAYS=30
GITHUB_WEBHOOK_DELIVERY_CLEANUP_BATCH_SIZE=500
SOURCELENS_GITHUB_APP_DRILL_INSTALLATION_ID=
SOURCELENS_GITHUB_APP_DRILL_REPOSITORY=
SOURCELENS_GITHUB_WEBHOOK_DRILL_EVENT=ping
SOURCELENS_GITHUB_WEBHOOK_DRILL_DELIVERY_ID=
SOURCELENS_GITHUB_WEBHOOK_DRILL_PAYLOAD_FILE=
SOURCELENS_GITHUB_WEBHOOK_DRILL_PAYLOAD_MAX_BYTES=65536

# === 发布验收，可选；设置后 prod-preflight 会执行 smoke target 检查 ===
SOURCELENS_BASE_URL=
SOURCELENS_SMOKE_CONNECT_TIMEOUT=5
SOURCELENS_SMOKE_MAX_TIME=15
SOURCELENS_RELEASE_EVIDENCE_TARGET_ENV=local
SOURCELENS_RELEASE_EVIDENCE_ALLOW_MUTATING_PROD=false
SOURCELENS_RELEASE_EVIDENCE_ALLOW_EXTERNAL_DRILLS=false

# === 备份恢复；生产发布前必须完成备份和恢复演练 ===
SOURCELENS_BACKUP_DIR=/var/backups/sourcelens
SOURCELENS_BACKUP_RETENTION_DAYS=14
SOURCELENS_BACKUP_ENCRYPTION_REQUIRED=true
SOURCELENS_BACKUP_TOOLCHAIN_EXECUTOR=docker:sourcelens-mysql
SOURCELENS_BACKUP_DRILL_BACKUP_ID=
SOURCELENS_BACKUP_DRILL_EVIDENCE_FILE=
SOURCELENS_BACKUP_DRILL_MYSQL_CONTAINER=sourcelens-mysql
SOURCELENS_BACKUP_DRILL_KEEP_WORK_DIR=false
SOURCELENS_BACKUP_RESTORE_DRILL_EVIDENCE_FILE=
SOURCELENS_BACKUP_RESTORE_DRILL_MAX_AGE_DAYS=7

# === 回滚演练；真实回滚前必须填写不可变目标、备份编号和计划文件 ===
SOURCELENS_ROLLBACK_TARGET_REF=
SOURCELENS_ROLLBACK_BACKUP_ID=
SOURCELENS_ROLLBACK_PLAN_FILE=
SOURCELENS_ROLLBACK_PLAN_MAX_AGE_DAYS=7

# === 分析器 ===
ANALYZER_PATH=sourcelens-analyzer
