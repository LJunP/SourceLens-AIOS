{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/schemas/blind-admission-envelope-v1.json",
  "title": "SourceLens cooperative-local blind admission task card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "source_artifact", "runtime_profile", "operation", "execution_policy"],
  "properties": {
    "schema_version": {"const": "blind-admission-task-card/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Z0-9_-]{8,96}$"},
    "source_artifact": {"$ref": "#/$defs/identity"},
    "runtime_profile": {"$ref": "#/$defs/identity"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "match", "replacement", "expected_replacements"],
      "properties": {
        "kind": {"const": "replace_exact"},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "match": {"type": "string", "minLength": 1, "maxLength": 4096},
        "replacement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "expected_replacements": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "stdout_max_bytes", "stderr_max_bytes", "external_effects"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
        "stdout_max_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "stderr_max_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "external_effects": {"$ref": "#/$defs/false_effects"}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "byte_length"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "false_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "provider", "secret", "remote", "production", "public"],
      "properties": {
        "network": {"const": false},
        "provider": {"const": false},
        "secret": {"const": false},
        "remote": {"const": false},
        "production": {"const": false},
        "public": {"const": false}
      }
    }
  }
}
